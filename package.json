{
  "name": "rungs",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": { "node": ">=22" },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build",
    "e2e": "pnpm --filter @rungs/web e2e",
    "check:submission": "pnpm --filter @rungs/submission check",
    "submission:fill": "pnpm --filter @rungs/submission fill"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/node": "^22.10.0",
    "typescript": "5.7.3",
    "vitest": "3.0.5"
  }
}
