# Rungs - environment template. Copy to .env (never commit .env).

# --- chain ---
CHAIN_ID=56
BSC_RPC_URL=https://bsc-rpc.publicnode.com        # replace with a keyed RPC for production
BSC_RPC_FALLBACK_URL=https://bsc-dataseed.binance.org
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545

# --- addresses (BNB Chain mainnet; verified 2026-11-25, re-checked in M01) ---
AGENT_ID_REGISTRY=0x60b9262456de011f7d15a54cdd8c48baaa8b022f
USDT_ADDRESS=0x55d398326f99059fF775485246999027B3197955   # 18 decimals
RUNGS_POOL_ADDRESS=                                # set after M04
RUNGS_POOL_DEPLOY_BLOCK=

# --- deploy ([HUMAN] creates and funds; gas money only) ---
DEPLOYER_PRIVATE_KEY=
OWNER_ADDRESS=                                     # a wallet the owner controls
INITIAL_MAX_OUTSTANDING=50000000000000000000       # 50 USDT
INITIAL_DAILY_NEW_LINE_CAP=20
BSCSCAN_API_KEY=                                   # [HUMAN] creates; used only for verification

# --- keeper ---
KEEPER_PORT=8787
KEEPER_DB_PATH=./data/rungs.sqlite
KEEPER_CYCLE_SECONDS=6
LOG_CHUNK=5000                                     # spike S8: publicnode served 50,000; the indexer halves on error
REORG_RESCAN_BLOCKS=30
TEAM_WALLETS=                                      # comma-separated; shown separately in /v1/stats
WEB_ORIGIN=http://localhost:5173                   # the only allowed CORS origin
PUBLIC_KEEPER_URL=http://localhost:8787            # used when rendering llms.txt and skill.md
RATE_LIMIT_PER_MINUTE=120

# --- region and mode (read by the KEEPER, which serves GET /v1/public/site) ---
BLOCKED_COUNTRIES=                                 # ISO codes, comma-separated; the owner decides
COUNTRY_HEADER=cf-ipcountry                        # the header your host or proxy sets
UNKNOWN_COUNTRY_POLICY=allow                       # block | allow
COMING_SOON=false

# --- web ---
VITE_KEEPER_URL=http://localhost:8787
VITE_CHAIN_ID=56
VITE_EXPLORER_URL=https://bscscan.com
VITE_REPO_URL=https://github.com/gnanam1990/rungs
