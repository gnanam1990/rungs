{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GET /v1/lines/:address/actions/:action",
  "type": "object",
  "oneOf": [
    {
      "additionalProperties": false,
      "required": [
        "ok",
        "to",
        "value",
        "data",
        "humanSummary",
        "bawPreviewCommand",
        "warnings",
        "asOfBlock"
      ],
      "properties": {
        "ok": {
          "const": true
        },
        "to": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{40}$"
        },
        "value": {
          "const": "0"
        },
        "data": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]*$"
        },
        "humanSummary": {
          "type": "string"
        },
        "bawPreviewCommand": {
          "type": "string"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "then": {
          "type": [
            "string",
            "null"
          ],
          "description": "the next action, e.g. repay after approve"
        },
        "asOfBlock": {
          "type": "integer"
        }
      }
    },
    {
      "additionalProperties": false,
      "required": [
        "ok",
        "reason",
        "code"
      ],
      "properties": {
        "ok": {
          "const": false
        },
        "reason": {
          "type": "string"
        },
        "code": {
          "enum": [
            "NotAgentId",
            "NoLine",
            "LineExists",
            "Frozen",
            "LoanOpen",
            "NoLoan",
            "BelowMin",
            "AboveLimit",
            "PoolShort",
            "CapReached",
            "DailyCapReached",
            "Paused",
            "VouchRule",
            "StakeLocked",
            "NothingToClaim",
            "BadInput"
          ]
        }
      }
    }
  ]
}
