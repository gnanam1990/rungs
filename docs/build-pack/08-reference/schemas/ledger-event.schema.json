{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "row of the keeper's events table",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "block",
    "logIndex",
    "tx",
    "time",
    "name",
    "args"
  ],
  "properties": {
    "block": {
      "type": "integer"
    },
    "logIndex": {
      "type": "integer"
    },
    "tx": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "time": {
      "type": "integer"
    },
    "name": {
      "enum": [
        "LineOpened",
        "Drawn",
        "Repaid",
        "WrittenOff",
        "Slashed",
        "Vouched",
        "Unvouched",
        "Claimed",
        "Funded",
        "Defunded",
        "CapsSet",
        "CapsRaiseQueued",
        "PauseSet"
      ]
    },
    "holder": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{40}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "args": {
      "type": "object",
      "description": "decoded event arguments; uint values as decimal strings"
    }
  }
}
